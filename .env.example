# Aegis — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ── Backend ───────────────────────────────────────────────────────────────────

# Database URL
# SQLite (development):
DATABASE_URL=sqlite:///./aegis.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aegis

# Path to journalist public key (relative to backend/ directory)
PUBLIC_KEY_PATH=keys/journalist_public.pem

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=https://submit.yourdomain.com

# ── Cloudflare ────────────────────────────────────────────────────────────────

# Your domain (used in setup.sh)
DOMAIN=yourdomain.com
